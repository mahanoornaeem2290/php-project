<?php
require __DIR__ . '/../includes/auth.php';
redirectIfNotLoggedIn('../login.php');

$pdo = getDbConnection();
$messages = $pdo->query('SELECT id, name, email, message, created_at FROM contacts ORDER BY created_at DESC')->fetchAll();
?>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
